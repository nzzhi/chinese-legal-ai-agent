NODE_ENV=development
PORT=3000

LLM_PROVIDER=openai-compatible
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_FLASH_MODEL=replace-with-flash-model
LLM_PRO_MODEL=replace-with-pro-model
# Per attempt, including response body reading; timeout retries at most once.
LLM_TIMEOUT_MS=120000

# Optional override; defaults to bundled OFL-licensed Noto Sans CJK SC.
# REPORT_PDF_FONT_PATH=/path/to/your-licensed-font.ttf
